@page "/cuenta/ingresar"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using ProveeduriaGanadera.Application.Autenticacion
@inject IAutenticacionService AutenticacionService
@inject NavigationManager Navigation

<PageTitle>Ingresar</PageTitle>

<div class="auth-card">
    <h1 class="fuente-titulo">Ingresar</h1>

    <EditForm Model="_form" FormName="ingresar" OnValidSubmit="Enviar" method="post">
        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="_form.Email" />
        </div>
        <div class="mb-3">
            <label>Contraseña</label>
            <InputText type="password" class="form-control" @bind-Value="_form.Password" />
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-warning">@_error</div>
        }

        <button type="submit" class="btn btn-primary">Ingresar</button>
    </EditForm>

    <p class="mt-3">¿No tenés cuenta? <a href="/cuenta/registrarse">Registrate</a></p>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginDto _form { get; set; } = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? _error;

    private async Task Enviar()
    {
        var usuario = await AutenticacionService.ValidarCredencialesAsync(_form.Email, _form.Password);
        if (usuario is null)
        {
            _error = "Email o contraseña incorrectos.";
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, usuario.Id.ToString()),
            new(ClaimTypes.Name, $"{usuario.Nombre} {usuario.Apellido}"),
            new(ClaimTypes.Email, usuario.Email),
            new(ClaimTypes.Role, usuario.Rol),
        };
        var identidad = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identidad));

        Navigation.NavigateTo("/", forceLoad: true);
    }
}
