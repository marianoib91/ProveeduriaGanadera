@page "/cuenta/registrarse"
@using ProveeduriaGanadera.Application.Autenticacion
@inject IAutenticacionService AutenticacionService
@inject NavigationManager Navigation

<PageTitle>Registrarse</PageTitle>

<div class="auth-card">
    <h1 class="fuente-titulo">Crear cuenta</h1>

    <EditForm Model="_form" FormName="registrarse" OnValidSubmit="Enviar" method="post">
        <div class="mb-3">
            <label>Nombre</label>
            <InputText class="form-control" @bind-Value="_form.Nombre" />
        </div>
        <div class="mb-3">
            <label>Apellido</label>
            <InputText class="form-control" @bind-Value="_form.Apellido" />
        </div>
        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="_form.Email" />
        </div>
        <div class="mb-3">
            <label>Contraseña</label>
            <InputText type="password" class="form-control" @bind-Value="_form.Password" />
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-warning">@_error</div>
        }

        <button type="submit" class="btn btn-primary">Crear cuenta</button>
    </EditForm>

    <p class="mt-3">¿Ya tenés cuenta? <a href="/cuenta/ingresar">Ingresá</a></p>
</div>

@code {
    [SupplyParameterFromForm]
    private RegistroDto _form { get; set; } = new();

    private string? _error;

    private async Task Enviar()
    {
        if (string.IsNullOrWhiteSpace(_form.Nombre) || string.IsNullOrWhiteSpace(_form.Email))
        {
            _error = "Nombre y email son obligatorios.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Password) || _form.Password.Length < 6)
        {
            _error = "La contraseña tiene que tener al menos 6 caracteres.";
            return;
        }

        var (exito, error, _) = await AutenticacionService.RegistrarClienteAsync(_form);
        if (!exito)
        {
            _error = error;
            return;
        }

        Navigation.NavigateTo("/cuenta/ingresar");
    }
}
